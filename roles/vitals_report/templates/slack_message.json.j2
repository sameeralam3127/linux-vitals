{#-
  Slack incoming-webhook payload, rendered as Block Kit.

  The whole payload is assembled as native Jinja structures and serialised
  once with `to_json` at the bottom, rather than written out as JSON text.
  That is deliberate: a hand-written JSON template has to get quoting,
  comma placement, and escaping right at every interpolation, and a single
  hostname containing a quote breaks the message for the whole fleet.

  Two things about the top-level `text` field, learned the hard way:

  1. It is NOT a silent fallback when `attachments` are present. Slack
     renders it as the message body, above the attachment. Putting the full
     plain-text summary there printed the entire old-style message above the
     new one, duplicated, which is exactly what this template exists to
     replace. It therefore holds one short line.
  2. It is still what Slack uses for the mobile push preview and for
     accessibility clients, so it cannot be empty -- a message with no
     usable `text` shows as blank in both.

  The per-host detail is a fixed-width table inside a code block rather than
  one block per host. Slack has no table primitive, and a code block is the
  only way to get columns that line up. It also collapses the per-host cost
  from N blocks to 1, so the message stays far inside Slack's 50-block limit
  at any fleet size -- the binding limit becomes the 3000-character text
  object, which is what caps the row count.

  Slack limits respected below:
    - 50 blocks per message            -> 9 at most, regardless of fleet size
    - 3000 characters per text object  -> host rows clamped (see budget)
    - 10 fields per section block      -> 4 used
    - 150 characters per plain_text header
-#}
{#- Slack mrkdwn escaping. Truncate first, then escape, so an entity can
    never be sliced in half by the length cap. -#}
{%- macro esc(value, limit=280) -%}
{{ value | string | truncate(limit, true, '…', 0) | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}
{%- endmacro -%}
{#- Cell text for the fixed-width table. A backtick would break out of the
    code fence and a newline would break column alignment. -#}
{%- macro cell(value, limit=28) -%}
{{ value | string | replace('`', "'") | replace('\n', ' ') | truncate(limit, true, '…', 0) | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}
{%- endmacro -%}
{%- set severity_order = ['critical', 'warning', 'info', 'none'] -%}
{%- set severity_short = {'critical': 'CRIT', 'warning': 'WARN', 'info': 'info', 'none': 'ok'} -%}
{%- set hbs = linux_vitals_summary.hosts_by_severity | default({}) -%}
{%- set fbs = linux_vitals_summary.findings_by_severity | default({}) -%}
{%- set critical_errors = linux_vitals_summary.critical_error_count | int -%}
{#- The PASS/FAIL word is derived exactly as slack_message.txt.j2 and
    generic_webhook_payload.json.j2 derive it. Severity only chooses the
    colour bar, so the three consumers can never disagree on the verdict. -#}
{%- set status_word = 'PASS' if critical_errors == 0 else 'FAIL' -%}
{%- if critical_errors > 0 or (hbs.get('critical', 0) | int) > 0 -%}
{%- set colour = '#e01e5a' -%}
{%- set status_icon = ':rotating_light:' -%}
{%- elif (hbs.get('warning', 0) | int) > 0 -%}
{%- set colour = '#ecb22e' -%}
{%- set status_icon = ':warning:' -%}
{%- else -%}
{%- set colour = '#2eb67d' -%}
{%- set status_icon = ':white_check_mark:' -%}
{%- endif -%}
{#- Collect the per-host results, then order them worst-first so the hosts
    that survive the cap are the ones worth reading. Bucketing by severity
    beats sorting: Jinja cannot sort by a rank map, and sorting tuples that
    end in a dict risks comparing dicts when the ranks tie. -#}
{%- set ns = namespace(results=[], ordered=[], blocks=[], lines=[], rows=[], widths=[]) -%}
{%- for host in linux_vitals_reporting_hosts | default(ansible_play_hosts_all) -%}
{%- set _ = ns.results.append(hostvars[host]['linux_vitals_result']) -%}
{%- endfor -%}
{%- set by_name = ns.results | sort(attribute='hostname') -%}
{%- for level in severity_order -%}
{%- for result in by_name -%}
{%- if (result.severity | default('none')) == level -%}
{%- set _ = ns.ordered.append(result) -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{#- A severity value outside the known set would otherwise be dropped
    silently, and a host missing from an alert is the failure mode this
    project treats as worst. Append anything the buckets did not claim. -#}
{%- for result in by_name -%}
{%- if result not in ns.ordered -%}
{%- set _ = ns.ordered.append(result) -%}
{%- endif -%}
{%- endfor -%}
{#- Host budget. linux_vitals_slack_max_hosts is the operator's cap; 25 is a
    hard ceiling. At roughly 90 characters per row that keeps the table
    inside the 3000-character limit of a single text object. -#}
{%- set requested_hosts = linux_vitals_slack_max_hosts | default(20) | int -%}
{%- set host_budget = [[requested_hosts, 25] | min, 0] | max -%}
{%- set shown = ns.ordered[:host_budget] -%}
{%- set hidden = ns.ordered | length - shown | length -%}
{#- 1. Header -#}
{%- set _ = ns.blocks.append({
  'type': 'header',
  'text': {'type': 'plain_text', 'text': linux_vitals_slack_message_header | string | truncate(150, true, '…', 0), 'emoji': true}
}) -%}
{#- 2. Overall verdict -#}
{%- set _ = ns.blocks.append({
  'type': 'section',
  'text': {'type': 'mrkdwn', 'text': status_icon ~ ' *Overall status: ' ~ status_word ~ '*\n' ~ esc(linux_vitals_summary.snippet)}
}) -%}
{#- 3. Counters, two columns -#}
{%- set _ = ns.blocks.append({
  'type': 'section',
  'fields': [
    {'type': 'mrkdwn', 'text': '*Servers checked*\n' ~ (linux_vitals_summary.servers_checked | int)},
    {'type': 'mrkdwn', 'text': '*Auto-fixed*\n' ~ (linux_vitals_summary.auto_fixed_count | int)},
    {'type': 'mrkdwn', 'text': '*Critical errors*\n' ~ critical_errors},
    {'type': 'mrkdwn', 'text': '*Health score*\n' ~ (linux_vitals_summary.health_score_pct | default(0)) ~ '% (' ~ esc(linux_vitals_summary.health_score_band | default('Unknown'), 40) ~ ')'}
  ]
}) -%}
{#- 4. Severity roll-up, only when there is anything to roll up -#}
{%- if (fbs.get('critical', 0) | int) + (fbs.get('warning', 0) | int) + (fbs.get('info', 0) | int) > 0 -%}
{%- set _ = ns.blocks.append({
  'type': 'context',
  'elements': [{'type': 'mrkdwn', 'text': '*Findings* ' ~ (fbs.get('critical', 0) | int) ~ ' critical · ' ~ (fbs.get('warning', 0) | int) ~ ' warning · ' ~ (fbs.get('info', 0) | int) ~ ' info  ·  *Hosts* ' ~ (hbs.get('critical', 0) | int) ~ ' critical · ' ~ (hbs.get('warning', 0) | int) ~ ' warning'}]
}) -%}
{%- endif -%}
{#- 5. Needs attention first: the critical hosts and why, above the table.
    This is the part an operator reads when the channel is busy. -#}
{%- set critical_results = ns.ordered | selectattr('severity', 'defined') | selectattr('severity', 'equalto', 'critical') | list -%}
{%- if critical_results -%}
{%- for result in critical_results[:5] -%}
{%- set messages = [] -%}
{%- for finding in result.findings | default([]) -%}
{%- if finding is mapping and finding.severity | default('') == 'critical' -%}
{%- set _ = messages.append(esc(finding.message, 120)) -%}
{%- endif -%}
{%- endfor -%}
{%- set _ = ns.lines.append('• *' ~ esc(result.hostname, 80) ~ '* — ' ~ (messages[:3] | join('; ') if messages else 'critical severity')) -%}
{%- endfor -%}
{%- if critical_results | length > 5 -%}
{%- set _ = ns.lines.append('_…and ' ~ (critical_results | length - 5) ~ ' more critical host(s)_') -%}
{%- endif -%}
{%- set _ = ns.blocks.append({
  'type': 'section',
  'text': {'type': 'mrkdwn', 'text': ('*Needs attention first*\n' ~ (ns.lines | join('\n'))) | truncate(2900, true, '…', 0)}
}) -%}
{%- endif -%}
{#- 6-8. Host breakdown as a fixed-width table: one block, any fleet size. -#}
{%- if linux_vitals_slack_include_host_breakdown and shown -%}
{%- set headings = ['HOST', 'STATUS', 'SEV', 'KERNEL', 'BOOTLDR', 'REBOOT', '/BOOT', 'LOGINS'] -%}
{%- for result in shown -%}
{%- set level = result.severity | default('none') -%}
{%- if result.bootloader_default_status | default('') == 'resolved' -%}
{%- set bootloader = 'latest' if result.bootloader_default_matches_latest else 'NOT latest' -%}
{%- elif result.bootloader_default_status | default('') == 'entry-only' -%}
{%- set bootloader = 'unresolved' -%}
{%- else -%}
{%- set bootloader = 'n/a' -%}
{%- endif -%}
{%- set _ = ns.rows.append([
  cell(result.hostname, 24),
  cell(result.final_status, 7),
  severity_short.get(level, cell(level, 5)),
  cell(result.running_kernel | default('unknown'), 22),
  bootloader,
  ('yes' if result.reboot_required else 'no'),
  cell(result.boot_space_status | default('?'), 9),
  (result.failed_login_count | default(0) | string)
]) -%}
{%- endfor -%}
{#- Column widths from the widest value actually present, so a narrow fleet
    does not pay for columns it does not use. -#}
{%- for index in range(headings | length) -%}
{%- set lengths = [headings[index] | length] -%}
{%- for row in ns.rows -%}
{%- set _ = lengths.append(row[index] | length) -%}
{%- endfor -%}
{%- set _ = ns.widths.append(lengths | max) -%}
{%- endfor -%}
{%- set table_lines = [] -%}
{%- set heading_cells = [] -%}
{%- for index in range(headings | length) -%}
{%- set _ = heading_cells.append(headings[index] ~ (' ' * (ns.widths[index] - headings[index] | length))) -%}
{%- endfor -%}
{%- set _ = table_lines.append(heading_cells | join('  ')) -%}
{%- set rule_cells = [] -%}
{%- for index in range(headings | length) -%}
{%- set _ = rule_cells.append('-' * ns.widths[index]) -%}
{%- endfor -%}
{%- set _ = table_lines.append(rule_cells | join('  ')) -%}
{%- for row in ns.rows -%}
{%- set row_cells = [] -%}
{%- for index in range(headings | length) -%}
{%- set _ = row_cells.append(row[index] ~ (' ' * (ns.widths[index] - row[index] | length))) -%}
{%- endfor -%}
{%- set _ = table_lines.append(row_cells | join('  ')) -%}
{%- endfor -%}
{%- set _ = ns.blocks.append({'type': 'divider'}) -%}
{%- set _ = ns.blocks.append({
  'type': 'section',
  'text': {'type': 'mrkdwn', 'text': '*Host breakdown*\n```\n' ~ ((table_lines | join('\n')) | truncate(2700, true, '…', 0)) ~ '\n```'}
}) -%}
{%- if hidden > 0 -%}
{%- set _ = ns.blocks.append({
  'type': 'context',
  'elements': [{'type': 'mrkdwn', 'text': '+ ' ~ hidden ~ ' more host(s) not shown — worst-first, see the dashboard for the full fleet.'}]
}) -%}
{%- endif -%}
{%- endif -%}
{#- 9. Footer. Always carries the project name, so the message is
    identifiable in a busy channel even when the header is customised. -#}
{%- set footer_text = 'LinuxVitals · ' ~ (linux_vitals_summary.servers_checked | int) ~ ' host(s) scanned' -%}
{%- if linux_vitals_slack_message_footer | default('') | trim -%}
{%- set footer_text = footer_text ~ ' · ' ~ esc(linux_vitals_slack_message_footer, 150) -%}
{%- endif -%}
{%- set _ = ns.blocks.append({
  'type': 'context',
  'elements': [{'type': 'mrkdwn', 'text': footer_text}]
}) -%}
{#- Slack renders the top-level `text` above the attachment, so it is one
    short line rather than the full plain-text summary. It doubles as the
    push-notification preview, which is why it leads with the verdict. -#}
{%- set preview = 'LinuxVitals: ' ~ status_word ~ ' — ' ~ (linux_vitals_summary.servers_checked | int) ~ ' host(s) checked, ' ~ critical_errors ~ ' critical, ' ~ (linux_vitals_summary.auto_fixed_count | int) ~ ' auto-fixed' -%}
{{ {'text': preview, 'attachments': [{'color': colour, 'fallback': preview, 'blocks': ns.blocks}]} | to_json }}
