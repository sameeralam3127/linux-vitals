{#-
  Plain-text body of the summary email, for linux_vitals_email_format: text
  (#145). The same content, in the same order, as email_message.html.j2.

  Lines stay under 79 characters so no mail client re-wraps them: one host is
  a short block, never one long line of `|`-separated fields. Finding text is
  word-wrapped under its severity tag.
-#}
{%- set severity_order = ['critical', 'warning', 'info', 'none'] -%}
{%- set hbs = linux_vitals_summary.hosts_by_severity | default({}) -%}
{%- set fbs = linux_vitals_summary.findings_by_severity | default({}) -%}
{%- set failing = linux_vitals_summary.critical_error_count | default(0) | int -%}
{%- set checked = linux_vitals_summary.servers_checked | default(0) | int -%}
{%- set unreported = linux_vitals_summary.unreported_hosts | default([]) -%}
{%- set status_word = linux_vitals_summary.overall_status | default('PASS' if failing == 0 and unreported | length == 0 else 'FAIL', true) -%}
{%- set phase = linux_vitals_phase | default('adhoc', true) | string -%}
{%- set maintenance_id = linux_vitals_maintenance_id | default('', true) | string | trim -%}
{%- set attached = linux_vitals_email_attach_report_effective | default(linux_vitals_email_attach_report | default(false)) | bool -%}
{%- set indent = '\n' ~ ' ' * 13 -%}
{%- set severity_label = {'critical': 'critical', 'warning': 'warning', 'info': 'info', 'none': 'ok'} -%}
{#- Worst-first, exactly as the HTML body and the Slack card order hosts. -#}
{%- set ns = namespace(entries=[], ordered=[]) -%}
{%- for host in linux_vitals_reporting_hosts | default(ansible_play_hosts_all) -%}
{%- set _ = ns.entries.append({'name': host, 'r': hostvars[host]['linux_vitals_result']}) -%}
{%- endfor -%}
{%- set by_name = ns.entries | sort(attribute='name') -%}
{%- for level in severity_order -%}
{%- for entry in by_name if (entry.r.severity | default('none')) == level -%}
{%- set _ = ns.ordered.append(entry) -%}
{%- endfor -%}
{%- endfor -%}
{%- for entry in by_name if entry not in ns.ordered -%}
{%- set _ = ns.ordered.append(entry) -%}
{%- endfor -%}
{%- set attention = [] -%}
{%- for entry in ns.ordered -%}
{%- set unknowns = entry.r.findings | default([]) | select('mapping') | selectattr('status', 'defined') | selectattr('status', 'equalto', 'unknown') | list -%}
{%- if entry.r.final_status | default('') == 'Fail' or (entry.r.severity | default('none')) in ['critical', 'warning'] or unknowns -%}
{%- set _ = attention.append(entry) -%}
{%- endif -%}
{%- endfor -%}
{{ linux_vitals_slack_message_header | default('LinuxVitals Health Check') }}: {{ status_word }}
{% if phase != 'adhoc' %}
{{ phase | capitalize }}{% if maintenance_id %} · {{ maintenance_id }}{% endif %}{{ '\n' }}
{% endif %}
{{ failing }} of {{ checked }} host{{ '' if checked == 1 else 's' }} failing{% if unreported %}, {{ unreported | length }} not checked{% endif %}{{ '\n' }}
Servers checked: {{ checked }} · Failing hosts: {{ failing }} · Auto-fixed: {{ linux_vitals_summary.auto_fixed_count | default(0) | int }}
Health score: {{ linux_vitals_summary.health_score_pct | default(0) }}% ({{ linux_vitals_summary.health_score_band | default('Unknown') }})
Findings: {{ fbs.get('critical', 0) | int }} critical · {{ fbs.get('warning', 0) | int }} warning · {{ fbs.get('info', 0) | int }} info
{% if unreported %}

Not checked
-----------
Targeted, but no health result: unreachable, or the play failed.
{% for entry in unreported %}
  {{ entry.inventory_name }}: {{ entry.reason | default('no result') }}{% if entry.baseline_available | default(false) %} (had a baseline){% endif %}

{% endfor %}
{% endif %}
{% if attention %}

Needs attention
---------------
{% for entry in attention %}
{% set r = entry.r %}
{% set findings = r.findings | default([]) | select('mapping') | list %}
{{ entry.name }}  {{ r.ip_address | default('') }}
  {{ r.final_status | default('unknown') }} · {{ severity_label.get(r.severity | default('none'), r.severity) }}{% if r.reboot_required | default(false) | bool %} · reboot required{% endif %}

{% for sev in ['critical', 'warning', 'info'] %}
{% for finding in findings if finding.status | default('fail') != 'unknown' and finding.severity | default('info') == sev %}
  {{ '%-11s' | format('[' ~ sev | upper ~ ']') }}{{ (finding.message | default(finding.id) ~ ((' (' ~ finding.subject ~ ')') if finding.subject | default('', true) and finding.subject not in finding.message | default('') else '')) | wordwrap(63, true, indent) }}
{% endfor %}
{% endfor %}
{% for finding in findings if finding.status | default('fail') == 'unknown' %}
  [UNKNOWN]  {{ finding.message | default(finding.id) | wordwrap(63, true, indent) }}
{% if finding.reason | default('', true) %}
             {{ ('Could not check: ' ~ finding.reason) | wordwrap(63, true, indent) }}
{% endif %}
{% endfor %}

{% endfor %}
{% endif %}
{% if linux_vitals_summary.comparison_active | default(false) | bool %}
{% set regressed = [] %}{% set improved = [] %}{% set fresh = [] %}
{% for entry in ns.ordered %}
{% set cmp = entry.r.comparison | default({}) %}
{% if not cmp.baseline_available | default(false) | bool %}{% set _ = fresh.append(entry) %}
{% elif cmp.status_regressed | default(false) | bool %}{% set _ = regressed.append(entry) %}
{% elif cmp.status_improved | default(false) | bool %}{% set _ = improved.append(entry) %}
{% endif %}
{% endfor %}

Since the baseline
------------------
{% if not (regressed or improved or fresh) %}
  No host changed status.
{% endif %}
{% for group in [['Regressed', regressed, 'new_findings', 'new'], ['Improved', improved, 'resolved_findings', 'resolved']] if group[1] %}
  {{ group[0] }}:
{% for entry in group[1] %}
{% set cmp = entry.r.comparison %}
{% set changed = cmp[group[2]] | default([]) | select('mapping') | map(attribute='id') | list %}
    {{ (entry.name ~ ': ' ~ cmp.status_before | default('?') ~ ' -> ' ~ cmp.status_after | default('?') ~ ((' (' ~ group[3] ~ ': ' ~ changed | join(', ') ~ ')') if changed else '')) | wordwrap(70, true, '\n      ') }}
{% endfor %}
{% endfor %}
{% if fresh %}
  No baseline:
    {{ fresh | map(attribute='name') | join(', ') | wordwrap(70, true, '\n    ') }}
{% endif %}
{% endif %}
{% if linux_vitals_slack_include_host_breakdown | default(true) | bool %}

All hosts
---------
{% set rows = [['HOST', 'ADDRESS', 'STATUS', 'SEVERITY', 'KERNEL', 'REBOOT']] %}
{% for entry in ns.ordered %}
{% set r = entry.r %}
{% set _ = rows.append([
  entry.name | string | truncate(22, true, '~', 0),
  r.ip_address | default('') | string,
  r.final_status | default('unknown') | string,
  severity_label.get(r.severity | default('none'), r.severity | string),
  r.running_kernel | default('unknown') | string | truncate(22, true, '~', 0),
  'yes' if r.reboot_required | default(false) | bool else 'no'
]) %}
{% endfor %}
{% set widths = [] %}
{% for index in range(6) %}
{% set _ = widths.append(rows | map(attribute=index) | map('length') | max) %}
{% endfor %}
{% for row in rows %}
{% set cells = [] %}
{% for index in range(6) %}
{% set _ = cells.append(row[index] ~ ' ' * (widths[index] - row[index] | length)) %}
{% endfor %}
{{ cells | join('  ') | trim }}
{% endfor %}
{% endif %}

{% if attached %}
Full details for every host are in the attached dashboard,
{{ linux_vitals_output_path | basename }}. Open it in a browser.
{% else %}
Full details for every host are in the dashboard on the controller:
{{ linux_vitals_output_path | default('') }}
{% endif %}
--
Sent by LinuxVitals{% if linux_vitals_slack_message_footer | default('') | trim %} · {{ linux_vitals_slack_message_footer }}{% endif %}
