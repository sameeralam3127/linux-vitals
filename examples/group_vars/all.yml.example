---
# Example group_vars/all.yml for LinuxVitals.
#
# Copy this file to group_vars/all.yml next to your inventory and uncomment
# the values you want to override. Inventory / group_vars / extra-vars values
# override role defaults; role defaults live in:
#   roles/vitals_scan/defaults/main.yml   (thresholds, log windows)
#   roles/vitals_heal/defaults/main.yml   (self-healing opt-in)
#   roles/vitals_report/defaults/main.yml (output, archiving, notifications)

# linux_vitals_output_path: "{{ inventory_dir }}/reports/linux_vitals_report.html"
# linux_vitals_log_window: "30 minutes ago"
# linux_vitals_audit_log_window: "7 days ago"
# linux_vitals_log_priority: err
# linux_vitals_log_max_lines: 2000
# linux_vitals_ram_warning_threshold: 80
# linux_vitals_ram_critical_threshold: 95
# linux_vitals_boot_warning_threshold: 20
# linux_vitals_load_warning_threshold: 1.5
# linux_vitals_load_critical_threshold: 3.0
# linux_vitals_psi_warning_threshold: 25
# linux_vitals_psi_critical_threshold: 50
# linux_vitals_swap_rate_warning_threshold: 100
# linux_vitals_swap_rate_critical_threshold: 1000
# linux_vitals_swap_sample_seconds: 2

# Filesystem capacity and inodes, across every real mount. `tmpfs` and
# `overlay` are checked by default -- both can back a mount that genuinely
# runs out. `/` is always in scope whatever its filesystem type.
# linux_vitals_disk_warning_threshold: 80
# linux_vitals_disk_critical_threshold: 95
# linux_vitals_disk_inode_warning_threshold: 80
# linux_vitals_disk_inode_critical_threshold: 95
# linux_vitals_disk_include_mounts:          # check these despite their fstype
#   - /snap/firefox/current
# linux_vitals_disk_exclude_mounts:          # never check these
#   - /etc/hostname
#   - /etc/hosts
#   - /etc/resolv.conf
# linux_vitals_disk_expected_readonly_mounts:  # read-only on purpose
#   - /mnt/golden-image

# Your own must-run units, checked exactly like the built-in three (sssd,
# systemd-journald, the resolved time-sync unit). Additive, never a
# replacement -- the built-in three always run regardless of this list.
# linux_vitals_required_services:
#   - nginx.service
#   - postgresql.service

# Self-healing is disabled by default; opt in explicitly. The settle
# variables bound how long a restarted unit is polled before the attempt is
# reported as unverified rather than fixed.
# linux_vitals_heal_enabled: true
# linux_vitals_heal_settle_retries: 10
# linux_vitals_heal_settle_delay: 3
# linux_vitals_heal_stability_seconds: 5
# The longest one restart may block the run. systemd applies no start timeout
# at all to a Type=oneshot unit, so without this one hung start job holds the
# whole linear run. Raise it for long-running oneshot jobs; 0 waits forever.
# linux_vitals_heal_restart_timeout: 120

# What self-healing may touch, and when. All off by default -- with none of
# these set, every failed unit that is enabled at boot is restarted. Patterns
# are globs against the unit name, with `.service` optional; the exclude list
# wins over the include list. A unit left alone is reported under
# self_healing.skipped_by_policy with the reason, never silently skipped.
# linux_vitals_heal_include_services:        # default: ["*"] (everything)
#   - nginx
#   - "chronyd*"
# linux_vitals_heal_exclude_services:        # never restart these
#   - postgresql                             # a restart can trigger failover
#   - "*-backup"                             # Type=oneshot: it runs the job again
# Over this many units in scope at once, leave the host entirely alone rather
# than restarting an arbitrary subset. 0 (the default) means no limit.
# linux_vitals_heal_max_restarts: 3
# Only restart inside this window, on the managed host's own clock. Both must
# be set together; an end before the start spans midnight.
# linux_vitals_heal_window_start: "01:00"
# linux_vitals_heal_window_end: "05:00"

# Finding severity. linux_vitals_fail_on_severity decides what fails a host:
# `info` (the default) fails it on any finding at all; raise it to triage.
# linux_vitals_fail_on_severity: warning
# linux_vitals_finding_severity_overrides:
#   apparmor_disabled: info
#   reboot_required: critical

# TLS certificate checks are disabled by default; opt in explicitly.
# linux_vitals_certs_enabled: true
# linux_vitals_cert_warning_days: 30
# linux_vitals_cert_critical_days: 7
# Connections are made from each managed host, so `localhost` means the
# certificate that host itself serves. Empty by default.
# linux_vitals_cert_endpoints:
#   - host: localhost
#     port: 443
#     server_name: www.example.com

# A postcheck warns when its baseline is older than this many hours; `0`
# disables the warning. Undated baselines are always reported as unknown-age.
# linux_vitals_baseline_max_age_hours: 72

# linux_vitals_slack_message_header: "Standard Maintenance Summary"
# linux_vitals_slack_message_footer: "Generated by LinuxVitals"
# linux_vitals_slack_include_host_breakdown: true
# linux_vitals_email_enabled: false
# linux_vitals_email_to:
#   - "ops@example.com"
# linux_vitals_email_from: "linux-vitals@example.com"
# linux_vitals_email_host: "smtp.example.com"
# linux_vitals_email_port: 587
# linux_vitals_email_secure: "starttls"
# linux_vitals_email_username: "smtp-user"
# linux_vitals_email_password: "smtp-password"
# linux_vitals_generic_webhook_enabled: true
# linux_vitals_generic_webhook_url: "https://example.com/health-events"
# linux_vitals_generic_webhook_headers:
#   Authorization: "Bearer example-token"
#
# Option 1: Set webhook/SMTP secrets directly here (not recommended for
# version-controlled inventories).
# linux_vitals_slack_webhook_url: "https://hooks.slack.com/services/your/team/webhook"
#
# Option 2 (recommended): store secrets in a local .env file as
# SLACK_WEBHOOK_URL=..., GENERIC_WEBHOOK_URL=..., EMAIL_SMTP_HOST=...,
# EMAIL_SMTP_USERNAME=..., EMAIL_SMTP_PASSWORD=... and vitals_report will
# auto-load them from {{ inventory_dir }}/.env -- that is, next to your
# inventory file, not next to the playbook. See .env.example and
# docs/architecture.md for why every path resolves from inventory_dir.
